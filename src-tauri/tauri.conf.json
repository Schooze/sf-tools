{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SF-Tools",
  "version": "0.2.1",
  "identifier": "com.sftools.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../artifacts/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "SF-Tools",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "useLocalToolsDir": true
  }
}
